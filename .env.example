# ------------------------------------------------------------------
# Bird Population Decline AI — Environment Variables
# ------------------------------------------------------------------
# Copy this file to `.env` for local development, and add the same
# keys in the Vercel dashboard (Project Settings -> Environment Variables)
# for production. NEVER commit your real .env file.
#
# NOTE: The MAPBOX token is a *public* client token (it is sent to the
# browser to render the map). Restrict it by URL in your Mapbox account.
# The Sentinel + OpenWeather secrets are used ONLY server-side and are
# never exposed to the client.
# ------------------------------------------------------------------

# Mapbox public access token (used client-side for the satellite basemap)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# OpenWeather API key (server-side)
OPENWEATHER_API_KEY=your_openweather_key_here

# Sentinel Hub OAuth client credentials (server-side)
# Get these free from the Copernicus Data Space Ecosystem (CDSE) dashboard:
#   https://shapps.dataspace.copernicus.eu/dashboard/  -> User Settings -> OAuth clients
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# Optional: Sentinel Hub endpoints. Defaults target CDSE (free tier).
# Uncomment/override only if using the legacy commercial deployment.
# SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# SENTINEL_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ------------------------------------------------------------------
# Optional hardening & ops (all have safe defaults; leave unset for dev)
# ------------------------------------------------------------------
# Restrict which browser origins may call /api/* (comma-separated hostnames).
# When unset, all origins are allowed (fine for local dev). Set in production
# to your deployed domain(s), e.g. "your-app.vercel.app".
# ALLOWED_ORIGIN_HOSTS=your-app.vercel.app

# Best-effort per-IP rate limit for /api/* (requests per minute; 0 disables).
# RATE_LIMIT_PER_MIN=60

# In-memory cache TTL (seconds) for repeated analyze calls on a warm instance.
# CACHE_TTL_SECONDS=600

# Optional Sentry error monitoring (no-op unless set and sentry-sdk installed).
# SENTRY_DSN=

# Optional: override Sentinel Hub endpoints (default to CDSE free tier).
# SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# SENTINEL_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
# SENTINEL_CATALOG_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
